# ============================================
# JAWIR OS - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# === AI Services ===
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_DEEPGRAM_API_KEY=your_deepgram_api_key_here

# === MQTT IoT ===
VITE_MQTT_BROKER_URL=mqtt://YOUR_VPS_IP:1883
VITE_MQTT_USERNAME=zaks
VITE_MQTT_PASSWORD=enggangodinginmcu

# === WhatsApp Gateway ===
VITE_WHATSAPP_API_URL=http://localhost:3000

# === Google Workspace (Optional) ===
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret

# === KiCad ===
KICAD_PATH=C:\Program Files\KiCad\8.0\bin

# === App Settings ===
NODE_ENV=development
LOG_LEVEL=debug
